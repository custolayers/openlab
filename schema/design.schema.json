{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenLab Design Solution",
  "type": "object",
  "required": [
    "design_id",
    "title",
    "summary",
    "status",
    "category"
  ],
  "properties": {
    "design_id": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "enum": ["experimental", "validated", "stable", "deprecated"]
    },
    "category": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tested_materials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
